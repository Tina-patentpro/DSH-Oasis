+// Host-owned metadata only. Technical prose and quoted materials retain their bytes.
+export function correctM02BodyMetadata(core,{receiptVersion,updates,modelCompletions}) {
+  if(typeof core!=='string'||!['v340-native-candidate-9','v340-native-candidate-10'].includes(receiptVersion)
+    ||!Array.isArray(updates)||!Array.isArray(modelCompletions))throw Error('M02_METADATA_INVALID')
+  const a=updates.filter(x=>x.content_origin==='model_completed').map(x=>x.content_id)
+  const b=modelCompletions.map(x=>x.content_id)
+  if(new Set(a).size!==a.length||new Set(b).size!==b.length||a.length!==b.length
+    ||a.some(id=>!b.includes(id))||modelCompletions.some(x=>x.human_confirmation_status!=='pending'))throw Error('M02_METADATA_PAIR_INVALID')
+  const lines=core.split('\n'),metadata=[
+    `- 合同与版本：Host 原始生成凭证 ${receiptVersion}；正文元信息修订 R3。`,
+    `- 交付状态：本次${a.length?'模型补齐待确认':'未产生模型补齐'}（登记 ${b.length} 条，更新 ${a.length} 条）；分析建议仍待专业审核。`,
+  ]
+  let fence=null,start=-1,end=lines.length
+  for(let i=0;i<lines.length;i++){
+    const marker=lines[i].match(/^\s{0,3}(`{3,}|~{3,})/)
+    if(marker){if(!fence)fence={char:marker[1][0],size:marker[1].length};else if(marker[1][0]===fence.char&&marker[1].length>=fence.size)fence=null;continue}
+    if(fence)continue
+    if(start<0&&lines[i]==='## 文档信息'){start=i;continue}
+    if(start>=0&&/^## /.test(lines[i])){end=i;break}
+  }
+  if(start<0)return `## 文档信息\n\n${metadata.join('\n')}\n\n${core}`
+  fence=null
+  const section=lines.slice(start+1,end).filter(line=>{
+    const marker=line.match(/^\s{0,3}(`{3,}|~{3,})/)
+    if(marker){if(!fence)fence={char:marker[1][0],size:marker[1].length};else if(marker[1][0]===fence.char&&marker[1].length>=fence.size)fence=null;return true}
+    return fence||!/^\s*- (合同与版本|交付状态)：/.test(line)
+  })
+  while(section.length&&section.at(-1)==='')section.pop()
+  return [...lines.slice(0,start+1),...section,...metadata,'',...lines.slice(end)].join('\n')
+}
