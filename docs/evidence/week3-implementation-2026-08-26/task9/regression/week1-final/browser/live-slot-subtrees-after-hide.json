            {
              "name": "id",
              "type": "string",
              "required": true,
              "description": "Your cell key. Use an id of your own: a fresh id is added beside the shipped entries, while reusing a shipped id puts you in THAT cell and replaces it. Owners that filter by id address you by it."
            },
            {
              "name": "order",
              "type": "number",
              "required": false,
              "description": "Position among the entries, ascending (default 0)."
            },
            {
              "name": "label",
              "type": "string | (() => string)",
              "required": false,
              "description": "Display text where the owner projects one (nav rows, tabs). A thunk is re-read on every projection, so localized text follows the active locale without re-registering."
            }
          ],
          "ownerProps": [
            "/**\n * The input-region slot currency: dock/left/right entries read\n * the conversation snapshot and the live input state as owner props (both\n * are point-in-time snapshots — the dispatching skeleton re-renders on\n * either store's change, so entries stay current without subscribing).\n */\nexport interface InputZone {\n  readonly session: ConversationSnapshot\n  readonly input: InputState\n}"
          ],
          "ownerPropsReferences": [
            "ConversationSnapshot",
            "InputState"
          ],
