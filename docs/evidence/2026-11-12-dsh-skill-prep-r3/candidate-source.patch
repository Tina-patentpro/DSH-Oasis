+import { createHash } from 'node:crypto'
+import { readFileSync } from 'node:fs'
+import { z } from 'zod'
+
+export const CHINA_PATENT_ROUTE_PREVIEW = 'skill-suite/patent-disclosure/route-preview'
+export const chinaPatentRouteInput = z.object({ text: z.string().trim().min(1).max(1000) }).strict()
+const resourcePin = '41348ce98399aeb0f5f847762805510b9c28380fa72af088f94e263ea66fc393'
+let resource
+
+function getResource() {
+  if (!resource) {
+    const bytes = readFileSync(new URL('./china-patent-router-resources.json', import.meta.url))
+    if (createHash('sha256').update(bytes).digest('hex') !== resourcePin) throw Error('Invalid router resource')
+    resource = JSON.parse(bytes.toString('utf8'))
+  }
+  return resource
+}
+
+const patterns = [
+  ['fence', /(?:专利布局|围栏|族树|保护型\s*1\s*\+\s*N)/iu],
+  ['divisional', /(?:发明分案|母案.{0,4}分案|分案原始披露|先做分案[一二三四五\d])/u],
+  ['docket', /(?:一条龙|案卷|交底.{0,12}(?:一起|再出).{0,5}申请|交底和申请一起|\/patent-docket\b)/iu],
+  ['application', /(?:申请底稿|申请文件|申报材料|\/patent-apply\b)/iu],
+  ['search-overseas', /(?:海外检索|PCT\s*检索|查(?:询|找)?\s*(?:美国|欧洲|日本|韩国|欧盟|海外).{0,3}专利)/iu],
+  ['reader', /(?:(?:解读|读懂|读).{0,12}(?:公开号|专利|PDF|全文)|解读.{0,4}(?:CN|US|EP|JP|KR|WO)[\s\d]|\/patent-read\b)/iu],
+  ['search-cn', /(?:按著录(?:字段|项目)|(?:检索|查).{0,8}(?:国内|公布公告|公开公告)|公开清单|\/patent-search\b)/iu],
+  ['chart', /(?:对照表|claim\s*chart|无效对照|FTO\s*初筛|侵权对照|\/patent-chart\b)/iu],
+  ['map', /(?:专利地图|案例地图|\/patent-map\b)/iu],
+  ['oa', /(?:审查意见.{0,16}答复|答复.{0,12}审查意见|审查答复|案例入库|\/oa\b)/iu],
+  ['policy', /(?:政策简报|政策雷达|技能进化|\/patent-(?:brief|exam-policy|evolve)\b)/iu],
+  ['disclosure', /(?:专利挖掘|交底书|查新|实用新型|外观设计|(?:整理|撰写|写成|起草).{0,8}交底|\/patent-disclosure\b)/iu],
+]
+const nestedRoutes = {
+  fence: ['disclosure'],
+  divisional: ['application', 'disclosure'],
+  docket: ['application', 'disclosure'],
+  application: ['disclosure'],
+  'search-overseas': ['search-cn'],
+}
+const gates = {
+  fence: 'confirmed-first-disclosure',
+  application: 'verified-disclosure-directory',
+  chart: 'verified-claim-features',
+  map: 'verified-reader-vault',
+  oa: 'verified-case-library',
+}
+
+export function previewChinaPatentRoute(input) {
+  const { text } = chinaPatentRouteInput.parse(input)
+  const { sourceRevision, sourceSha256, routes, oaToolMismatch } = getResource()
+  const base = { sourceRevision, sourceSha256, dispatchEnabled: false }
+  const selected = new Set()
+  for (const clause of text.normalize('NFKC').split(/[。！？；，、\n,.!?;]/u)) {
+    const positive = clause.split(/(?:不要|不必|无需|禁止|请勿|不需要|不做|不进行)/u, 1)[0]
+    const matches = patterns.filter(([, pattern]) => pattern.test(positive)).map(([id]) => id)
+    const nested = new Set(matches.flatMap(id => nestedRoutes[id] ?? []))
+    for (const id of matches) if (!nested.has(id)) selected.add(id)
+  }
+  if (selected.size !== 1) return { ...base, status: 'needs-clarification',
+    reason: selected.size === 0 ? 'unmatched' : 'multiple-intents', routeId: null }
+  const [routeId] = selected
+  const gate = routeId === 'oa' && oaToolMismatch ? 'chart-tool-version-mismatch' : gates[routeId] ?? null
+  return { ...base, ...routes[routeId], routeId, gate,
+    status: gate === 'chart-tool-version-mismatch' ? 'blocked' : gate ? 'needs-material' : 'selected' }
+}
