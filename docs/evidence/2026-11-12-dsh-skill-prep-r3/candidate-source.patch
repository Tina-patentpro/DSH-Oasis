+import assert from 'node:assert/strict'
+import test from 'node:test'
+import { createV340RuntimeService } from '../src/v340-runtime-service.js'
+import { createM06BusinessNativeCandidate013 } from '../src/v340-native-model.js'
+import { createWorkbenchRpcHandler } from '../src/workbench-rpc.js'
+import { Assembler, MODEL_OUTPUT, NOW, setupNative } from './helpers/v340-native-harness.mjs'
+
+const cases = [
+  ['Flow-1-3', 'search_target_text', 'patent-overview-search', '0.3.0-rc.4', /仅交检索策略/],
+  ['Flow-1-4', 'solution_selection_basis_text', 'patent-solution-selection', '0.3.0-rc.4', /申请类型留空/],
+  ['Flow-2-7', 'claims_text', 'patent-specification-draft', '0.3.0-rc.3', /权项、交底、附图/],
+]
+
+for (const [nodeId, field, skillId, version, instruction] of cases) {
+  test(`${nodeId} binds its exact standalone Skill and dispatches one synthetic request`, async t => {
+    const draft = { source: 'local-skill', textInputs: { [field]: '公开合成滑移组件。' }, filePaths: {}, configuration: {} }
+    const h = await setupNative(t, { nodeId, draft, output: MODEL_OUTPUT })
+    await h.service.closeV340Runtime()
+    Object.assign(h.route, { provider: 'deepseek-official', model: 'deepseek-flash', reasoningEffort: 'low' })
+    const prepare = h.ctx.llm.prepareCall
+    h.ctx.llm.prepareCall = async (...args) => ({ ...await prepare(...args), retryPolicy: { mode: 'normal', maxRetries: 0 } })
+    let suite = 'oasis'
+    const executor = createM06BusinessNativeCandidate013({
+      ctx: h.ctx, native: { BlockAssembler: Assembler, createUserMessage: value => ({ role: 'user', ...value }) },
+      getLocalSkillSuite: () => suite, textBatch: true,
+    })
+    const service = createV340RuntimeService({ repository: h.repository, preparation: h.preparation, executor, clock: () => NOW })
+    t.after(() => service.closeV340Runtime())
+    const confirmationCommand = h.command({ sessionId: 's', confirmed: true })
+    suite = 'patent-disclosure'
+    await assert.rejects(() => service.prepareV340CandidateConfirmation(confirmationCommand))
+    suite = 'oasis'
+    const confirmation = await service.prepareV340CandidateConfirmation(confirmationCommand)
+    assert.equal(confirmation.businessSkillId, skillId)
+    assert.equal(confirmation.businessSkillVersion, version)
+    const command = () => h.command({ requestKey: 'text-batch-two', candidate: { sessionId: 's', confirmed: true, sha256: confirmation.sha256 } })
+    assert.equal(h.seen.stream, 0)
+    await service.createV340Run(command())
+    const result = await h.settle()
+    assert.equal(result.status, 'completed')
+    assert.equal(result.nativeCandidate.version, 'v340-native-candidate-7')
+    assert.match(h.seen.options.system, instruction)
+    const wire = JSON.parse(h.seen.options.messages[0].content[0].text)
+    assert.equal(wire.values[field], draft.textInputs[field])
+    assert.equal(wire.values.application_type, undefined)
+    assert.equal(h.seen.options.tools, undefined)
+    await service.createV340Run(command())
+    assert.equal(h.seen.stream, 1)
+  })
+}
+
+test('China route preview is suite-scoped and stops at unchecked material', async () => {
+  let suite = 'oasis'
+  const handler = createWorkbenchRpcHandler({}, null, null, null, {
+    getLocalSkillSuite: () => suite, patentRoutePreview: true,
+  })
+  const route = text => handler('skill-suite/patent-disclosure/route-preview', { text })
+  const disabled = await route('请出申请底稿，项目里没有交底目录。')
+  assert.equal(disabled.error.code, 'PATENT_ROUTER_UNAVAILABLE')
+  suite = 'patent-disclosure'
+  const selected = await route('请出申请底稿，项目里没有交底目录。')
+  assert.equal(selected.ok, true)
+  assert.equal(selected.value.routeId, 'application')
+  assert.equal(selected.value.status, 'needs-material')
+  assert.equal(selected.value.gate, 'verified-disclosure-directory')
+  assert.equal(selected.value.dispatchEnabled, false)
+  const pureRead = await route('请解读公开号 US223898A，只交可读笔记。')
+  assert.equal(pureRead.value.routeId, 'reader')
+  const noChart = await route('请整理交底书，不要做对照表。')
+  assert.equal(noChart.value.routeId, 'disclosure')
+  const conflicts = await route('请制作专利地图。也请编写政策简报。')
+  assert.equal(conflicts.value.status, 'needs-clarification')
+  const unrecognized = await route('整理一下这些内容。')
+  assert.equal(unrecognized.value.status, 'needs-clarification')
+})
